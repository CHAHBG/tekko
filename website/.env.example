# ── Server ──────────────────────────────────────────────
SERVER_PORT=4000

# Public base URLs — the brand is currently LIVE on tapal.geochifa.com.
# To switch the brand to tekko.sn:
#   1. Point tekko.sn DNS (A record) to the server IP
#   2. Run: certbot --nginx -d tekko.sn -d www.tekko.sn
#   3. Set the URLs below to https://tekko.sn and rebuild the frontend (npm run build)
SERVER_PUBLIC_URL=https://tapal.geochifa.com
PUBLIC_CARD_BASE_URL=https://tapal.geochifa.com/c

DATABASE_PATH=./data/tekko.db
UPLOAD_DIR=./uploads
ADMIN_DASHBOARD_TOKEN=change-this-admin-token

# ── Payments: Wave (primary) ────────────────────────────
WAVE_API_KEY=
WAVE_SIGNING_SECRET=
WAVE_WEBHOOK_SECRET=
WAVE_SUCCESS_URL=https://tapal.geochifa.com/?payment=success
WAVE_ERROR_URL=https://tapal.geochifa.com/?payment=error

# ── Payments: CinetPay (fallback) ───────────────────────
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_NOTIFY_URL=https://tapal.geochifa.com/api/payments/cinetpay/webhook
CINETPAY_RETURN_URL=https://tapal.geochifa.com/
CINETPAY_CANCEL_URL=https://tapal.geochifa.com/

# ── Frontend (Vite) ─────────────────────────────────────
VITE_API_BASE_URL=/api
VITE_PUBLIC_CARD_BASE_URL=https://tapal.geochifa.com/c
VITE_GOOGLE_MAPS_KEY=
